/**
 * The app Sprig edits. Workers Builds deploys `main` to production and every
 * other branch (`sprig/*`) to its own Worker Preview.
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "woc-nb-2",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"main": "src/server.ts",
	"observability": { "enabled": true },
	"vars": {
		// Origins allowed to embed this app in an iframe (Sprig Studio's preview pane).
		"FRAME_ANCESTORS": "https://tria.seahi.workers.dev"
	},
	// Worker Previews (`wrangler preview`, one per branch). Bind preview-only resources here,
	// never production data.
	"previews": {
		"vars": {
			"FRAME_ANCESTORS": "https://tria.seahi.workers.dev"
		},
		"d1_databases": [
			{
				"binding": "DB",
				"database_name": "woc-nb-2-db-preview",
				"database_id": "dc86e526-e49d-477f-b09b-05d78f6827a6"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "woc-nb-2-db",
			"database_id": "3db0bd3d-4ec3-44ad-8041-209fc0345476",
			"preview_database_id": "dc86e526-e49d-477f-b09b-05d78f6827a6"
		}
	]
}
